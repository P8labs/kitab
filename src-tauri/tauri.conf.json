{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kitab",
  "version": "1.0.1",
  "identifier": "in.p8labs.kitab",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "kitab",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Lightweight desktop note taking app",
    "publisher": "P8labs",
    "copyright": "Copyright (c) P8labs",
    "createUpdaterArtifacts": true,
    "targets": "all",
    "windows": {
      "allowDowngrades": false,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": true,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "P8labs",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "displayLanguageSelector": true,
        "minimumWebview2Version": "110.0.1531.0",
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "English"
        ]
      },
      "wix": {
        "language": "en-US",
        "upgradeCode": "ddace959-7ff0-562e-8a39-d08ebd3ff5af",
        "fragmentPaths": [
          "./windows/fragments/registry.wxs"
        ],
        "componentRefs": [
          "KitabRegistryEntries"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzODAzQzVEMDY0MTg2QkQKUldTOWhrRUdYVHlBczFwZ2xWVTB1aWNycG9CQXVLV2FVZnhHM3pMQUdtUFc4Y0pWU1A3M0pDU1oK",
      "endpoints": [
        "https://github.com/P8labs/kitab/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
